# PostgreSQL connection string (Neon in production; any local Postgres 18 for dev).
DATABASE_URL=postgresql://user:password@localhost:5432/refund_agent

# Which LLM provider llm.py's extract_refund_request() uses. One of:
#   groq (free tier, default) | openai | xai | anthropic
# See llm.py -- groq/openai/xai share one OpenAI-compatible code path,
# anthropic gets its own (different SDK/response shape).
LLM_PROVIDER=groq

# Optional: override the default model for the selected provider.
# LLM_MODEL=openai/gpt-oss-20b

# Only the API key matching LLM_PROVIDER above needs to be set.
# Groq (free): https://console.groq.com/keys -- never commit a real key.
GROQ_API_KEY=gsk
# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# xAI (Grok): https://console.x.ai/
# XAI_API_KEY=xai-...
# Anthropic: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: chat submission rate limit (AD-11). Defaults shown.
CHAT_RATE_LIMIT_PER_WINDOW=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated list of origins allowed to call this API from a browser
# (CORS). Default covers the local Next.js dev server; add the deployed
# Vercel origin(s) in production, e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,https://refund-agent.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Stripe test-mode secret key (Story 1.2) -- the Stripe Refund Tool.
# Validated at API startup: a missing/invalid key fails at boot, matching
# DATABASE_URL. Get a test key from https://dashboard.stripe.com/test/apikeys
# -- never commit a real key.
STRIPE_SECRET_KEY=sk_test_...
